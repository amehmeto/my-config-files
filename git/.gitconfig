[user]
	email = 42amehmeto@gmail.com
	name = amehmeto
[rerere]
	enabled = true
[core]
	excludes = ~/.gitignore_global
	pager = diff-so-fancy | less --tabs=4 -RFX
[pull]
	rebase = false
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = diff-so-fancy --patch
[init]
	defaultBranch = main
[include]
	# Machine-specific config (credential helpers, work email, etc.).
	# Not versioned — see README "Local secrets" section.
	path = ~/.gitconfig.local
[safe]
	directory = /Users/amehmeto/actions-runner/_work/TiedSiren/TiedSiren
	directory = /Users/amehmeto/actions-runner-tapdeck/_work/TapDeck/TapDeck
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
